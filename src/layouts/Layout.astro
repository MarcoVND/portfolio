---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="MVNWeb portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="navbar bg-base-100 border-b-2">
      <div class="flex-1">
        <a class="btn btn-ghost text-sm">Marco Vázquez</a>
        <a class="btn btn-ghost text-sm">Sobre mí</a>
        <a class="btn btn-ghost text-sm">Skills</a>
        <a class="btn btn-ghost text-sm">Proyectos</a>
        <a class="btn btn-ghost text-sm">Contacto</a>
      </div>
      <div class="flex-none">
        <button class="btn btn-primary text-white">
          Descargar CV
        </button>
      </div>
    </div>
  </body>
</html>
